# Build output
/bin/

# Dependency and build caches. These live inside the workspace because the
# default Go and npm cache locations are outside it on this machine, and the
# toolchain must be able to write to them.
/.cache/

# Go
*.exe
*.test
*.out

# Node
node_modules/
web/dist/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- 私密配置：只提交 *.example ----
#
# 用通配而不是逐条列名：`.env.local` / `.env.deploy` / `.env.prod`
# 这类变体太多，漏一个就等于把口令推上了仓库。例外用 ! 显式放行模板。
.env
.env.*
!.env.example
deploy/.env
deploy/.env.*
!deploy/.env.example

# 服务器清单里有公网 IP；只在本地保存，仓库里放 servers.example.json。
deploy/servers.json
# ssh-keyscan 的产物，同样属于环境信息。
deploy/known_hosts
