# ---------------------------------------------------------------------------
# 本地开发配置模板
#
#   cp .env.example .env      # 然后填写真实值
#
# 为什么放在 deploy/ 而不是仓库根：
#   Compose 从「项目目录」加载 .env，项目目录默认就是 compose 文件所在目录。
#   compose 文件在 deploy/，所以 .env 也必须在这里，否则
#   `cd deploy && docker compose up` 读不到它，所有变量都会走默认值或报缺失。
#
# .env 保存真实凭据，已被 .gitignore 忽略，永远不要提交。
# 本模板只有占位符，可以安全提交。
#
# 生产环境的同名变量不在这里配置，而是放在两处：
#   * CI 侧：Gitee / GitHub 仓库的 Secrets
#   * 服务器：服务器上 deploy/.env（权限设为 600）
# ---------------------------------------------------------------------------

# ---- MySQL ----
# root 密码：MySQL 容器初始化时使用，也是健康检查用的账号
MYSQL_ROOT_PASSWORD=change-me-root
# 业务库名，由 MySQL 容器自动创建
MYSQL_DATABASE=xiangqi
# 应用使用的普通账号。它没有建库权限，这是有意的：
# server 容器以 -no-create-db 启动，建库交给 MySQL 容器的 MYSQL_DATABASE。
MYSQL_USER=xiangqi
MYSQL_PASSWORD=change-me-app

# 端口默认只绑本机，供 Windows 侧的 IDE / 数据库工具连接。
# 需要局域网访问时才改成 0.0.0.0（并自行确认防火墙策略）。
MYSQL_BIND=127.0.0.1
MYSQL_PORT=3306

# ---- 应用 ----
XIANGQI_PORT=8080
# development 或 production。production 时会强制要求 JWT 密钥不是占位值。
XIANGQI_ENV=development
# 生产环境必须换成足够长的随机值：openssl rand -hex 32
XIANGQI_JWT_SECRET=dev-insecure-secret-change-me
# 允许的 WebSocket 来源，逗号分隔。留空表示只允许同源，适合本机开发。
# 线上只允许自己的域名开 WebSocket。留空等于放行任意来源，公网暴露时很危险。
# 线上域名。deploy.sh 用它在部署时渲染 nginx 站点配置（deploy/nginx/site.conf.template），
# 所以仓库里只需要这个变量存在，不需要出现真实域名。
XIANGQI_DOMAIN=<你的域名>
XIANGQI_ALLOWED_ORIGINS=https://<你的域名>

# ---- 对局时钟（0 = 不限时，保持项目默认行为）----
XIANGQI_TURN_TIMEOUT=0
XIANGQI_GAME_TIMEOUT=0

# ---- 镜像 ----
# 本地开发用构建出的镜像；生产环境指向阿里云 ACR 地址，
# 由 CI 构建推送，服务器只负责拉取。
XIANGQI_IMAGE=xiangqi:dev
