# ---------------------------------------------------------------------------
# 部署配置模板（供 scripts/deploy.sh 使用）
#
#   cp .env.deploy.example .env.deploy   # 然后填写真实值
#
# .env.deploy 存着镜像仓库密码，已被 .gitignore 忽略，永远不要提交。
# 本模板只有占位符，可以安全提交。
#
# 用法：
#   bash scripts/deploy.sh v1.0.0                  # 构建 + 推送 + 部署
#   bash scripts/deploy.sh v1.0.0 --no-deploy      # 只构建 + 推送
# ---------------------------------------------------------------------------

# ---- 阿里云容器镜像服务 ACR ----
# 控制台位置：容器镜像服务 → 镜像工具 → 访问凭证
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ACR_NAMESPACE=change-me-namespace
ACR_USERNAME=change-me-username
ACR_PASSWORD=change-me-password

# ---- 生产服务器的 MySQL 镜像（可选）----
# 服务器若拉不动 Docker Hub（镜像加速器可能缺个别镜像），
# 先把镜像推到自己的 ACR，再在这里指向它：
#   docker tag mysql:8.4 <ACR_REGISTRY>/<ACR_NAMESPACE>/mysql:8.4
#   docker push <ACR_REGISTRY>/<ACR_NAMESPACE>/mysql:8.4
# 留空则服务器直接拉 Docker Hub 的 mysql:8.4。
MYSQL_IMAGE=

# ---- 部署用 SSH 私钥 ----
# 留空则默认使用 ~/.ssh/id_ed25519。
# 建议为部署单独生成一把，泄露时只需吊销它：
#   ssh-keygen -t ed25519 -C "xiangqi-deploy" -f ~/.ssh/xiangqi_deploy -N ""
#   ssh-copy-id -i ~/.ssh/xiangqi_deploy.pub root@你的服务器
DEPLOY_SSH_KEY=
